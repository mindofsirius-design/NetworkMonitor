<Window x:Class="NetworkMonitor.Views.StatisticsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="&#x0421;&#x0442;&#x0430;&#x0442;&#x0438;&#x0441;&#x0442;&#x0438;&#x043A;&#x0430;" Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">
    
    <Window.Resources>
        <ControlTemplate x:Key="DarkTrackerTemplate">
            <oxy:TrackerControl Position="{Binding Position}" LineExtents="{Binding PlotModel.PlotArea}"
                            Background="#FF2B2B2B" BorderBrush="#FF555555">
                <TextBlock Text="{Binding Text}" Foreground="White" Margin="7"/>
            </oxy:TrackerControl>
        </ControlTemplate>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Row 3 — подпись таблицы -->
            <RowDefinition Height="Auto"/>  <!-- Row 4 — таблица -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#4CAF50" CornerRadius="8" Padding="20,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="В сети" Foreground="White" FontSize="13"/>
                    <TextBlock Text="{Binding OnlineCount}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#F44336" CornerRadius="8" Padding="20,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Не в сети" Foreground="White" FontSize="13"/>
                    <TextBlock Text="{Binding OfflineCount}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#F59F00 " CornerRadius="8" Padding="20,12">
                <StackPanel>
                    <TextBlock Text="Не стабильно" FontSize="13"/>
                    <TextBlock Text="{Binding UnstableCount}" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="4" Text="Период:"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

            <ComboBox Grid.Column="5" x:Name="PeriodBox"
              ItemsSource="{Binding Periods}"
              SelectedItem="{Binding SelectedPeriod}"
              Style="{StaticResource MaterialDesignOutlinedComboBox}"
              Width="100"/>
        </Grid>

        <oxy:PlotView Grid.Row="1" Model="{Binding LatencyPlot}" Margin="0,0,0,8"
                      DefaultTrackerTemplate="{StaticResource DarkTrackerTemplate}"/>
        <oxy:PlotView Grid.Row="2" Model="{Binding PacketLossPlot}" Margin="0,0,0,8"
                      DefaultTrackerTemplate="{StaticResource DarkTrackerTemplate}"/>

        <TextBlock Grid.Row="3" Text="Доступность узлов (процент успешных ping-ответов за период)" 
           FontWeight="SemiBold" Margin="0,8,0,4"/>
        <DataGrid Grid.Row="4" ItemsSource="{Binding UptimeRows}" AutoGenerateColumns="False"
                  IsReadOnly="True" MaxHeight="200">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Узел" Binding="{Binding NodeName}" Width="*"/>
                    <DataGridTextColumn Header="24ч" Binding="{Binding Uptime24h}" Width="80"/>
                <DataGridTextColumn Header="7д" Binding="{Binding Uptime7d}" Width="80"/>
                <DataGridTextColumn Header="30д" Binding="{Binding Uptime30d}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        
    </Grid>
</Window>
